{
  "name": "org.jarvis",
  "version": "1.0.0",
  "description": "JARVIS — multi-agent AI command center with voice failover",
  "main": "dist-electron/electron/main.js",
  "author": "JARVIS Project",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-dev-electron.mjs\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "playwright test tests/mark05-core.spec.ts tests/mark05-runtime.spec.ts tests/mark05-approval.spec.ts tests/mark05-verification.spec.ts",
    "doctor": "node scripts/doctor.mjs",
    "test:speech": "npm run build && node scripts/test-speech-sanitizer.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vladmandic/face-api": "^1.7.15",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "node-edge-tts": "^1.2.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "selenium-webdriver": "^4.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ORG.JARVIS",
    "productName": "JARVIS",
    "artifactName": "JARVIS-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "models/**",
      ".env",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      },
      {
        "from": "public/kokoro_synth.py",
        "to": "kokoro_synth.py"
      },
      {
        "from": "references/jarvisai",
        "to": "jarvis-python"
      }
    ]
  }
}
